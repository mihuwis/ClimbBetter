# Real Firebase dev project. Values are the public Web app configuration.
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Protect Mihu's first login from creating a second empty CB account.
# Set register only when intentionally enabling new users.
VITE_AUTH_ACCOUNT_MODE=existing
# VITE_API_URL can stay empty: Vite proxies /api to the local backend.
