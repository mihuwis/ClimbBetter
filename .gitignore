# ClimbBetter - repository ignore rules

# Local agent files and archived/reference material
/.agents/
/.codex/
/backend-net/
/docs/
/app-plan.md
/frontend-web/front-plan.md
/frontend-mobile/mobile-plan.md

# Secrets and local environment configuration
.env
.env.*
!.env.example
!.env.*.example

# Java / Spring / Maven
**/target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*
.mvn/timing.properties

# Keep Maven Wrapper files in the repository
!backend/.mvn/wrapper/maven-wrapper.jar

# React / Node / Vite
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/android/.gradle/
**/android/local.properties
*.symbols
*.map.json

# Keep dependency lock files in the repository
!frontend-web/package-lock.json
!frontend-mobile/pubspec.lock

# IDEs and editors
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
.history/
*.code-workspace
*.swp
*.swo
*~

# Keep selected shared VS Code configuration, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating-system files
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Temporary files and local databases
*.tmp
*.temp
*.bak
*.pid
*.sqlite
*.sqlite3
*.db
